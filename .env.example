# ─────────────────────────────────────────────────────────────
# BIENENSTOCK — variáveis de ambiente (copie para .env)
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ============ Banco de dados (MySQL) ============
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=bienenstock
MYSQL_USER=bienenstock
MYSQL_PASSWORD=bienenstock

# ============ Administrador inicial ============
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=admin123

# ============ Desenvolvimento (docker-compose.yml) ============
# Porta em que o app fica acessível no host
APP_PORT=8080

# ============ Produção com Caddy + HTTPS (docker-compose.prod.yml) ============
# Domínio público — deve apontar (DNS A/AAAA) para este servidor
DOMAIN=eventos.exemplo.com
# E-mail usado pelo Let's Encrypt para emitir/renovar o certificado
ACME_EMAIL=voce@exemplo.com
